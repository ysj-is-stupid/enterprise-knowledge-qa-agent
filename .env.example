# 离线模式无需配置环境变量。
# 真实模型模式已支持 OpenAI-compatible Chat Completions；请复制为 .env 或在终端中设置变量，勿提交真实密钥。
KNOWLEDGE_QA_API_KEY=
KNOWLEDGE_QA_BASE_URL=
KNOWLEDGE_QA_MODEL=
KNOWLEDGE_QA_TIMEOUT_SECONDS=30

# DeepSeek 兼容别名（与上方通用变量二选一；通用变量优先）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=30
